// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  barbeariaId  Int?
  nome         String
  email        String        @unique
  senha        String
  telefone     String?
  dataNascimento DateTime?
  barbeiro     Boolean
  papel        String        @default("CUSTOMER")
  barbearia    Barbearia?    @relation(fields: [barbeariaId], references: [id])
  agendamentos Agendamento[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  logsAuditoria LogAuditoria[]
  lembretesRelacionamento LembreteRelacionamento[]
  avaliacoes Avaliacao[]

  @@index([barbeariaId])
  @@map("usuarios")
}

model Profissional {
  id                   Int           @id @default(autoincrement())
  barbeariaId          Int
  nome                 String
  descricao            String        @db.Text
  imagemURL            String
  avaliacao            Float
  quantidadeAvaliacoes Int
  barbearia            Barbearia     @relation(fields: [barbeariaId], references: [id])
  agendamentos         Agendamento[]
  bloqueiosAgenda      BloqueioAgenda[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  avaliacoes           Avaliacao[]

  @@unique([barbeariaId, nome])
  @@index([barbeariaId])
  @@map("profissionais")
}

model Servico {
  id           Int           @id @default(autoincrement())
  barbeariaId  Int
  nome         String
  descricao    String        @db.Text
  preco        Decimal       @db.Decimal(10, 2)
  qtdeSlots    Int
  imagemURL    String
  barbearia    Barbearia     @relation(fields: [barbeariaId], references: [id])
  agendamentos Agendamento[]

  @@unique([barbeariaId, nome])
  @@index([barbeariaId])
  @@map("servicos")
}

model Agendamento {
  id          Int      @id @default(autoincrement())
  data        DateTime
  barbeariaId Int
  status      String   @default("AGENDADO")
  valorTotal  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id])

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int

  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  profissionalId Int

  servicos Servico[]
  avaliacao Avaliacao?

  @@index([barbeariaId])
  @@index([profissionalId, data])
  @@map("agendamentos")
}

model Barbearia {
  id            Int            @id @default(autoincrement())
  nome          String
  slug          String         @unique
  telefone      String?
  email         String?
  nomePublico   String?
  descricaoPublica String?     @db.Text
  imagemCapaURL String?
  endereco      String?
  bairro        String?
  cidade        String?
  estado        String?
  latitude      Float?
  longitude     Float?
  aceitaAgendamentoOnline Boolean @default(true)
  destaque      Boolean        @default(false)
  status        String         @default("TRIAL")
  reviewStatus  String         @default("APPROVED")
  approvedAt    DateTime?
  approvedById  Int?
  rejectedAt    DateTime?
  rejectedById  Int?
  reviewReason  String?        @db.Text
  comercialStatus String        @default("NOVO")
  notasInternas String?         @db.Text
  ultimoContatoEm DateTime?
  proximoContatoEm DateTime?
  trialEndsAt   DateTime?
  antecedenciaMinutos Int      @default(30)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  unidades      Unidade[]
  usuarios      Usuario[]
  profissionais Profissional[]
  servicos      Servico[]
  agendamentos  Agendamento[]
  horariosFuncionamento HorarioFuncionamento[]
  bloqueiosAgenda       BloqueioAgenda[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  assinatura             AssinaturaBarbearia?
  logsAuditoria          LogAuditoria[]
  lembretesRelacionamento LembreteRelacionamento[]
  avaliacoes             Avaliacao[]

  @@map("barbearias")
}

model Unidade {
  id          Int       @id @default(autoincrement())
  barbeariaId Int
  nome        String
  endereco    String?
  telefone    String?
  ativa       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id])
  horariosFuncionamento HorarioFuncionamento[]
  bloqueiosAgenda       BloqueioAgenda[]

  @@unique([barbeariaId, nome])
  @@index([barbeariaId])
  @@map("unidades")
}

model HorarioFuncionamento {
  id              Int       @id @default(autoincrement())
  barbeariaId     Int
  unidadeId       Int?
  diaSemana       Int
  inicio          String    @db.VarChar(5)
  fim             String    @db.VarChar(5)
  intervaloInicio String?   @db.VarChar(5)
  intervaloFim    String?   @db.VarChar(5)
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  barbearia       Barbearia @relation(fields: [barbeariaId], references: [id])
  unidade         Unidade?  @relation(fields: [unidadeId], references: [id])

  @@index([barbeariaId, diaSemana])
  @@index([unidadeId])
  @@map("horarios_funcionamento")
}

model BloqueioAgenda {
  id             Int           @id @default(autoincrement())
  barbeariaId    Int
  profissionalId Int?
  unidadeId      Int?
  inicio         DateTime
  fim            DateTime
  motivo         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  barbearia      Barbearia     @relation(fields: [barbeariaId], references: [id])
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  unidade        Unidade?      @relation(fields: [unidadeId], references: [id])

  @@index([barbeariaId, inicio, fim])
  @@index([profissionalId, inicio, fim])
  @@index([unidadeId, inicio, fim])
  @@map("bloqueios_agenda")
}

model LancamentoFinanceiro {
  id             Int           @id @default(autoincrement())
  barbeariaId    Int
  profissionalId Int?
  usuarioId      Int?
  tipo           String
  categoria      String?
  descricao      String
  valor          Decimal       @db.Decimal(10, 2)
  data           DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  barbearia      Barbearia     @relation(fields: [barbeariaId], references: [id])
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  usuario        Usuario?      @relation(fields: [usuarioId], references: [id])

  @@index([barbeariaId, data])
  @@index([profissionalId, data])
  @@index([usuarioId])
  @@map("lancamentos_financeiros")
}

model PlanoAssinatura {
  id              Int                  @id @default(autoincrement())
  nome            String               @unique
  slug            String               @unique
  descricao       String               @db.Text
  precoMensal     Decimal              @db.Decimal(10, 2)
  limiteUsuarios  Int
  limiteUnidades  Int
  limiteServicos  Int
  recursos        Json
  ativo           Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assinaturas     AssinaturaBarbearia[]

  @@map("planos_assinatura")
}

model AssinaturaBarbearia {
  id              Int              @id @default(autoincrement())
  barbeariaId     Int              @unique
  planoId         Int
  status          String           @default("TRIAL")
  trialEndsAt     DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean        @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  barbearia       Barbearia        @relation(fields: [barbeariaId], references: [id])
  plano           PlanoAssinatura  @relation(fields: [planoId], references: [id])

  @@index([planoId])
  @@index([status])
  @@map("assinaturas_barbearia")
}

model LogAuditoria {
  id          Int       @id @default(autoincrement())
  barbeariaId Int?
  usuarioId   Int?
  acao        String
  entidade    String
  entidadeId  String?
  detalhes    Json?
  createdAt   DateTime  @default(now())
  barbearia   Barbearia? @relation(fields: [barbeariaId], references: [id])
  usuario     Usuario?   @relation(fields: [usuarioId], references: [id])

  @@index([barbeariaId, createdAt])
  @@index([usuarioId, createdAt])
  @@map("logs_auditoria")
}

model LembreteRelacionamento {
  id             Int          @id @default(autoincrement())
  barbeariaId    Int
  usuarioId      Int?
  agendamentoId  Int?
  tipo           String
  canal          String       @default("WHATSAPP")
  status         String       @default("PENDENTE")
  mensagem       String       @db.Text
  dataPrevista   DateTime
  enviadoEm      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  barbearia      Barbearia    @relation(fields: [barbeariaId], references: [id])
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([barbeariaId, status, dataPrevista])
  @@index([usuarioId])
  @@map("lembretes_relacionamento")
}

model Avaliacao {
  id             Int          @id @default(autoincrement())
  barbeariaId    Int
  agendamentoId  Int          @unique
  usuarioId      Int
  profissionalId Int
  nota           Int
  comentario     String?      @db.Text
  status         String       @default("APPROVED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  barbearia      Barbearia    @relation(fields: [barbeariaId], references: [id])
  agendamento    Agendamento  @relation(fields: [agendamentoId], references: [id])
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  @@index([barbeariaId, status])
  @@index([profissionalId, status])
  @@index([usuarioId])
  @@map("avaliacoes")
}
