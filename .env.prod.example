# MODELO SEM SEGREDOS. Copie para .env.prod fora de public_html e preencha.
# Node.js 22+. scripts/producao.cjs carrega este arquivo explicitamente.
NODE_ENV=production
PUBLIC_APP_URL=https://uniflowabs.top
NEXT_PUBLIC_API_URL=https://uniflowabs.top/api
CORS_ORIGINS=https://uniflowabs.top
# PORT/HOST definidos pelo painel têm prioridade. Não use um PORT global para os dois processos.
FRONTEND_PORT=3000
BACKEND_PORT=4000
HOST=127.0.0.1
TZ=America/Sao_Paulo
APP_TIME_ZONE=America/Sao_Paulo

# Dados do MySQL fornecidos pela hospedagem; NÃO usar infra-mysql-1 do Docker local.
# Codifique caracteres especiais do usuário/senha como componentes de URL.
DATABASE_URL="mysql://PREENCHA_USUARIO:PREENCHA_SENHA@PREENCHA_HOST:3306/PREENCHA_BANCO"
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_EXCLUSIVO_1
AGENDAMENTO_ACAO_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_EXCLUSIVO_2
PAYMENT_WEBHOOK_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_EXCLUSIVO_3
NOTIFICACOES_CALLBACK_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_EXCLUSIVO_4
SUPER_ADMIN_EMAILS=PREENCHA_EMAIL_ADMINISTRADOR

# Diretórios privados propostos para a estrutura informada pelo responsável.
MIDIA_STORAGE_DIR=/home/rico4167/domains/uniflowabs.top/uniflow-storage/midias
MIDIA_GALERIA_DIR=/home/rico4167/domains/uniflowabs.top/uniflow/apps/frontend/public

# Ativar somente após homologação; exige processo API persistente, não adormecido.
NOTIFICACOES_WORKER_ATIVO=false
NOTIFICACOES_WORKER_INTERVALO_MS=5000
ATENDIMENTOS_WORKER_ATIVO=false
ATENDIMENTOS_WORKER_INTERVALO_MS=5000
ATENDIMENTOS_WORKER_LOCK_MS=60000
ATENDIMENTOS_WORKER_MAX_TENTATIVAS=5
