{
  "name": "uniflow-abs",
  "private": true,
  "scripts": {
    "prod:build": "node scripts/producao.cjs build",
    "prod:web": "node scripts/producao.cjs web",
    "prod:api": "node scripts/producao.cjs api",
    "prod:migrate": "node scripts/producao.cjs migrate",
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.10",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
