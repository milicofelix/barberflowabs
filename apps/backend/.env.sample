# Dentro do Docker, use o host/nome do container MySQL conectado na rede externa shared_net.
DATABASE_URL="mysql://barberflow:barberflow@infra-mysql-1:3306/uniflow_abs"
JWT_SECRET=SEGREDO_AQUI!!!
AGENDAMENTO_ACAO_SECRET=SEGREDO_EXCLUSIVO_PARA_LINKS_DE_AGENDAMENTO
PUBLIC_APP_URL=http://localhost:3000
MIDIA_STORAGE_DIR=./storage/midias
MIDIA_GALERIA_DIR=../frontend/public
SUPER_ADMIN_EMAILS="milicofelix@gmail.com"
