// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  barbeariaId  Int
  nome         String
  email        String        @unique
  senha        String
  telefone     String?
  barbeiro     Boolean
  barbearia    Barbearia     @relation(fields: [barbeariaId], references: [id])
  agendamentos Agendamento[]
  lancamentosFinanceiros LancamentoFinanceiro[]

  @@index([barbeariaId])
  @@map("usuarios")
}

model Profissional {
  id                   Int           @id @default(autoincrement())
  barbeariaId          Int
  nome                 String
  descricao            String        @db.Text
  imagemURL            String
  avaliacao            Float
  quantidadeAvaliacoes Int
  barbearia            Barbearia     @relation(fields: [barbeariaId], references: [id])
  agendamentos         Agendamento[]
  bloqueiosAgenda      BloqueioAgenda[]
  lancamentosFinanceiros LancamentoFinanceiro[]

  @@unique([barbeariaId, nome])
  @@index([barbeariaId])
  @@map("profissionais")
}

model Servico {
  id           Int           @id @default(autoincrement())
  barbeariaId  Int
  nome         String
  descricao    String        @db.Text
  preco        Decimal       @db.Decimal(10, 2)
  qtdeSlots    Int
  imagemURL    String
  barbearia    Barbearia     @relation(fields: [barbeariaId], references: [id])
  agendamentos Agendamento[]

  @@unique([barbeariaId, nome])
  @@index([barbeariaId])
  @@map("servicos")
}

model Agendamento {
  id          Int      @id @default(autoincrement())
  data        DateTime
  barbeariaId Int
  status      String   @default("AGENDADO")
  valorTotal  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  barbearia Barbearia @relation(fields: [barbeariaId], references: [id])

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int

  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  profissionalId Int

  servicos Servico[]

  @@index([barbeariaId])
  @@index([profissionalId, data])
  @@map("agendamentos")
}

model Barbearia {
  id            Int            @id @default(autoincrement())
  nome          String
  slug          String         @unique
  telefone      String?
  email         String?
  antecedenciaMinutos Int      @default(30)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  unidades      Unidade[]
  usuarios      Usuario[]
  profissionais Profissional[]
  servicos      Servico[]
  agendamentos  Agendamento[]
  horariosFuncionamento HorarioFuncionamento[]
  bloqueiosAgenda       BloqueioAgenda[]
  lancamentosFinanceiros LancamentoFinanceiro[]

  @@map("barbearias")
}

model Unidade {
  id          Int       @id @default(autoincrement())
  barbeariaId Int
  nome        String
  endereco    String?
  telefone    String?
  ativa       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id])
  horariosFuncionamento HorarioFuncionamento[]
  bloqueiosAgenda       BloqueioAgenda[]

  @@unique([barbeariaId, nome])
  @@index([barbeariaId])
  @@map("unidades")
}

model HorarioFuncionamento {
  id              Int       @id @default(autoincrement())
  barbeariaId     Int
  unidadeId       Int?
  diaSemana       Int
  inicio          String    @db.VarChar(5)
  fim             String    @db.VarChar(5)
  intervaloInicio String?   @db.VarChar(5)
  intervaloFim    String?   @db.VarChar(5)
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  barbearia       Barbearia @relation(fields: [barbeariaId], references: [id])
  unidade         Unidade?  @relation(fields: [unidadeId], references: [id])

  @@index([barbeariaId, diaSemana])
  @@index([unidadeId])
  @@map("horarios_funcionamento")
}

model BloqueioAgenda {
  id             Int           @id @default(autoincrement())
  barbeariaId    Int
  profissionalId Int?
  unidadeId      Int?
  inicio         DateTime
  fim            DateTime
  motivo         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  barbearia      Barbearia     @relation(fields: [barbeariaId], references: [id])
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  unidade        Unidade?      @relation(fields: [unidadeId], references: [id])

  @@index([barbeariaId, inicio, fim])
  @@index([profissionalId, inicio, fim])
  @@index([unidadeId, inicio, fim])
  @@map("bloqueios_agenda")
}

model LancamentoFinanceiro {
  id             Int           @id @default(autoincrement())
  barbeariaId    Int
  profissionalId Int?
  usuarioId      Int?
  tipo           String
  categoria      String?
  descricao      String
  valor          Decimal       @db.Decimal(10, 2)
  data           DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  barbearia      Barbearia     @relation(fields: [barbeariaId], references: [id])
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  usuario        Usuario?      @relation(fields: [usuarioId], references: [id])

  @@index([barbeariaId, data])
  @@index([profissionalId, data])
  @@index([usuarioId])
  @@map("lancamentos_financeiros")
}
