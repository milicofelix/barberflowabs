# Dentro do Docker, use o host/nome do container MySQL conectado na rede externa shared_net.
DATABASE_URL="mysql://barberflow:barberflow@infra-mysql-1:3306/barberflow_abs"
JWT_SECRET=SEGREDO_AQUI!!!
SUPER_ADMIN_EMAILS="marcao@barberflowabs.app"
NOTIFICACOES_WORKER_ATIVO=true
NOTIFICACOES_WORKER_INTERVALO_MS=5000
NOTIFICACOES_CALLBACK_SECRET="troque-este-segredo-em-producao"
# Segredo compartilhado com o gateway para validar eventos recebidos. Use um valor longo e exclusivo por ambiente.
PAYMENT_WEBHOOK_SECRET="SUBSTITUA_POR_UM_SEGREDO_FORTE"
