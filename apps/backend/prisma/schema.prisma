// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  estabelecimentoId  Int?
  nome         String
  email        String        @unique
  senha        String
  telefone     String?
  dataNascimento DateTime?
  membroEstabelecimento     Boolean
  papel        String        @default("CUSTOMER")
  estabelecimento    Estabelecimento?    @relation(fields: [estabelecimentoId], references: [id])
  agendamentos Agendamento[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  logsAuditoria LogAuditoria[]
  caixasAbertos FechamentoCaixa[] @relation("CaixaAbertoPor")
  caixasFechados FechamentoCaixa[] @relation("CaixaFechadoPor")
  lembretesRelacionamento LembreteRelacionamento[]
  avaliacoes Avaliacao[]
  denunciasRevisadas DenunciaPerfilPublico[] @relation("DenunciaPerfilRevisor")
  estabelecimentosCliente ClienteEstabelecimento[]
  reagendamentosRealizados HistoricoReagendamento[] @relation("HistoricoReagendamentoAutor")
  vinculosEquipe MembroEquipe[]

  @@index([estabelecimentoId])
  @@map("usuarios")
}

model Profissional {
  id                   Int           @id @default(autoincrement())
  estabelecimentoId          Int
  nome                 String
  descricao            String        @db.Text
  imagemURL            String
  avaliacao            Float
  quantidadeAvaliacoes Int
  estabelecimento            Estabelecimento     @relation(fields: [estabelecimentoId], references: [id])
  agendamentos         Agendamento[]
  bloqueiosAgenda      BloqueioAgenda[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  avaliacoes           Avaliacao[]
  especialidades       ProfissionalEspecialidade[]
  servicosHabilitados  ProfissionalServico[]
  vinculoEquipe        MembroEquipe?
  escalas              EscalaProfissional[]
  configuracoesComissao ConfiguracaoComissao[]
  repassesFinanceiros   RepasseFinanceiro[]

  @@unique([estabelecimentoId, nome])
  @@index([estabelecimentoId])
  @@map("profissionais")
}

model Servico {
  id           Int           @id @default(autoincrement())
  estabelecimentoId  Int
  nome         String
  descricao    String        @db.Text
  preco        Decimal       @db.Decimal(10, 2)
  qtdeSlots    Int
  imagemURL    String
  observacoes  String?        @db.Text
  modeloAtendimento String    @default("PRESENCIAL")
  duracaoMinutos       Int     @default(15)
  preparoAntesMinutos  Int     @default(0)
  preparoDepoisMinutos Int     @default(0)
  deslocamentoMinutos  Int     @default(0)
  estabelecimento    Estabelecimento     @relation(fields: [estabelecimentoId], references: [id])
  agendamentos Agendamento[]
  requisitos   ServicoRequisito[]
  especialidades ServicoEspecialidade[]
  profissionaisHabilitados ProfissionalServico[]
  recursosNecessarios      ServicoRecurso[]
  itensAgendamento         AgendamentoServico[]
  configuracoesComissao    ConfiguracaoComissao[]

  @@unique([estabelecimentoId, nome])
  @@index([estabelecimentoId])
  @@map("servicos")
}

model Agendamento {
  id          Int      @id @default(autoincrement())
  data        DateTime
  estabelecimentoId Int
  status      String   @default("AGENDADO")
  valorTotal  Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dataFim     DateTime?
  inicioOcupacao DateTime?
  fimOcupacao DateTime?
  unidadeId   Int?
  modeloAtendimento String @default("PRESENCIAL")
  enderecoAtendimento String? @db.Text
  deslocamentoMinutos Int @default(0)
  reagendadoEm DateTime?

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  unidade   Unidade?  @relation(fields: [unidadeId], references: [id])

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId Int

  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  profissionalId Int

  servicos Servico[]
  itens AgendamentoServico[]
  recursos AgendamentoRecurso[]
  historicoReagendamentos HistoricoReagendamento[]
  avaliacao Avaliacao?
  contasFinanceiras ContaFinanceira[]

  @@index([estabelecimentoId])
  @@index([profissionalId, data])
  @@index([profissionalId, inicioOcupacao, fimOcupacao])
  @@index([unidadeId, inicioOcupacao, fimOcupacao])
  @@map("agendamentos")
}

model Estabelecimento {
  id            Int            @id @default(autoincrement())
  nome          String
  slug          String         @unique
  telefone      String?
  email         String?
  nomePublico   String?
  descricaoPublica String?     @db.Text
  imagemCapaURL String?
  endereco      String?
  bairro        String?
  cidade        String?
  estado        String?
  latitude      Float?
  longitude     Float?
  aceitaAgendamentoOnline Boolean @default(true)
  destaque      Boolean        @default(false)
  status        String         @default("TRIAL")
  reviewStatus  String         @default("APPROVED")
  approvedAt    DateTime?
  approvedById  Int?
  rejectedAt    DateTime?
  rejectedById  Int?
  reviewReason  String?        @db.Text
  comercialStatus String        @default("NOVO")
  notasInternas String?         @db.Text
  ultimoContatoEm DateTime?
  proximoContatoEm DateTime?
  trialEndsAt   DateTime?
  antecedenciaMinutos Int      @default(30)
  tipoEstabelecimento String   @default("BARBEARIA")
  modeloAtendimento   String   @default("PRESENCIAL")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  unidades      Unidade[]
  usuarios      Usuario[]
  profissionais Profissional[]
  servicos      Servico[]
  agendamentos  Agendamento[]
  horariosFuncionamento HorarioFuncionamento[]
  bloqueiosAgenda       BloqueioAgenda[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  assinatura             AssinaturaEstabelecimento?
  logsAuditoria          LogAuditoria[]
  lembretesRelacionamento LembreteRelacionamento[]
  avaliacoes             Avaliacao[]
  denunciasPerfil        DenunciaPerfilPublico[]
  clientes                ClienteEstabelecimento[]
  segmentos               EstabelecimentoSegmento[]
  especialidades          EstabelecimentoEspecialidade[]
  especialidadesProfissionais ProfissionalEspecialidade[]
  especialidadesServicos      ServicoEspecialidade[]
  profissionaisServicos       ProfissionalServico[]
  recursos                     Recurso[]
  membrosEquipe                MembroEquipe[]
  escalasProfissionais         EscalaProfissional[]
  indisponibilidadesRecursos   IndisponibilidadeRecurso[]
  configuracoesComissao        ConfiguracaoComissao[]
  formasPagamento              FormaPagamento[]
  contasFinanceiras            ContaFinanceira[]
  fechamentosCaixa             FechamentoCaixa[]
  repassesFinanceiros          RepasseFinanceiro[]
  eventosGateway               EventoGatewayPagamento[]
  conciliacoesFinanceiras      ConciliacaoFinanceira[]

  @@map("estabelecimentos")
}

model Segmento {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  nome            String
  descricao       String?   @db.Text
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  especialidades  Especialidade[]
  estabelecimentos EstabelecimentoSegmento[]

  @@map("segmentos")
}

model Especialidade {
  id               Int       @id @default(autoincrement())
  segmentoId       Int
  slug             String
  nome             String
  descricao        String?   @db.Text
  ativo             Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  segmento         Segmento  @relation(fields: [segmentoId], references: [id])
  estabelecimentos EstabelecimentoEspecialidade[]
  profissionais    ProfissionalEspecialidade[]
  servicos         ServicoEspecialidade[]

  @@unique([segmentoId, slug])
  @@index([segmentoId, ativo])
  @@map("especialidades")
}

model EstabelecimentoSegmento {
  id          Int       @id @default(autoincrement())
  estabelecimentoId Int
  segmentoId  Int
  principal   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  segmento    Segmento  @relation(fields: [segmentoId], references: [id])

  @@unique([estabelecimentoId, segmentoId])
  @@index([segmentoId])
  @@map("estabelecimentos_segmentos")
}

model EstabelecimentoEspecialidade {
  id              Int           @id @default(autoincrement())
  estabelecimentoId     Int
  especialidadeId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  estabelecimento       Estabelecimento     @relation(fields: [estabelecimentoId], references: [id])
  especialidade   Especialidade @relation(fields: [especialidadeId], references: [id])

  @@unique([estabelecimentoId, especialidadeId])
  @@index([especialidadeId])
  @@map("estabelecimentos_especialidades")
}

model ProfissionalEspecialidade {
  id              Int           @id @default(autoincrement())
  estabelecimentoId     Int
  profissionalId  Int
  especialidadeId Int
  principal       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  estabelecimento       Estabelecimento     @relation(fields: [estabelecimentoId], references: [id])
  profissional    Profissional  @relation(fields: [profissionalId], references: [id])
  especialidade   Especialidade @relation(fields: [especialidadeId], references: [id])

  @@unique([profissionalId, especialidadeId])
  @@index([estabelecimentoId, profissionalId])
  @@index([especialidadeId])
  @@map("profissionais_especialidades")
}

model ServicoEspecialidade {
  id              Int           @id @default(autoincrement())
  estabelecimentoId     Int
  servicoId       Int
  especialidadeId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  estabelecimento       Estabelecimento     @relation(fields: [estabelecimentoId], references: [id])
  servico         Servico       @relation(fields: [servicoId], references: [id])
  especialidade   Especialidade @relation(fields: [especialidadeId], references: [id])

  @@unique([servicoId, especialidadeId])
  @@index([estabelecimentoId, servicoId])
  @@index([especialidadeId])
  @@map("servicos_especialidades")
}

model ProfissionalServico {
  id             Int          @id @default(autoincrement())
  estabelecimentoId    Int
  profissionalId Int
  servicoId      Int
  ativo          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  estabelecimento      Estabelecimento    @relation(fields: [estabelecimentoId], references: [id])
  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  servico        Servico      @relation(fields: [servicoId], references: [id])

  @@unique([profissionalId, servicoId])
  @@index([estabelecimentoId, ativo])
  @@index([servicoId])
  @@map("profissionais_servicos")
}

model Recurso {
  id          Int       @id @default(autoincrement())
  estabelecimentoId Int
  unidadeId   Int?
  nome        String
  tipo        String
  capacidade  Int       @default(1)
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  unidade     Unidade?  @relation(fields: [unidadeId], references: [id])
  reservas    AgendamentoRecurso[]
  indisponibilidades IndisponibilidadeRecurso[]

  @@unique([estabelecimentoId, nome])
  @@index([estabelecimentoId, tipo, ativo])
  @@index([unidadeId, tipo, ativo])
  @@map("recursos")
}

model MembroEquipe {
  id             Int           @id @default(autoincrement())
  estabelecimentoId    Int
  usuarioId      Int
  profissionalId Int?          @unique
  papel          String        @default("PROFISSIONAL")
  permissoes     Json
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  estabelecimento      Estabelecimento     @relation(fields: [estabelecimentoId], references: [id])
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])

  @@unique([estabelecimentoId, usuarioId])
  @@index([estabelecimentoId, ativo])
  @@map("membros_equipe")
}

model EscalaProfissional {
  id              Int          @id @default(autoincrement())
  estabelecimentoId     Int
  profissionalId Int
  unidadeId       Int?
  diaSemana       Int
  inicio          String       @db.VarChar(5)
  fim             String       @db.VarChar(5)
  intervaloInicio String?      @db.VarChar(5)
  intervaloFim    String?      @db.VarChar(5)
  ativo           Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  estabelecimento       Estabelecimento    @relation(fields: [estabelecimentoId], references: [id])
  profissional    Profissional @relation(fields: [profissionalId], references: [id])
  unidade         Unidade?     @relation(fields: [unidadeId], references: [id])

  @@index([estabelecimentoId, diaSemana, ativo])
  @@index([profissionalId, diaSemana, ativo])
  @@index([unidadeId])
  @@map("escalas_profissionais")
}

model IndisponibilidadeRecurso {
  id          Int      @id @default(autoincrement())
  estabelecimentoId Int
  recursoId   Int
  inicio      DateTime
  fim         DateTime
  motivo      String?  @db.Text
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  recurso     Recurso   @relation(fields: [recursoId], references: [id])

  @@index([estabelecimentoId, inicio, fim])
  @@index([recursoId, inicio, fim, ativo])
  @@map("indisponibilidades_recursos")
}

model ServicoRecurso {
  id          Int      @id @default(autoincrement())
  servicoId   Int
  tipoRecurso String
  quantidade  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  servico     Servico  @relation(fields: [servicoId], references: [id])

  @@unique([servicoId, tipoRecurso])
  @@map("servicos_recursos")
}

model AgendamentoServico {
  id                   Int         @id @default(autoincrement())
  agendamentoId        Int
  servicoId            Int
  ordem                Int
  duracaoMinutos       Int
  preparoAntesMinutos  Int         @default(0)
  preparoDepoisMinutos Int         @default(0)
  preco                Decimal     @db.Decimal(10, 2)
  createdAt            DateTime    @default(now())
  agendamento           Agendamento @relation(fields: [agendamentoId], references: [id])
  servico               Servico     @relation(fields: [servicoId], references: [id])

  @@unique([agendamentoId, ordem])
  @@index([servicoId])
  @@map("agendamentos_servicos")
}

model AgendamentoRecurso {
  id            Int         @id @default(autoincrement())
  agendamentoId Int
  recursoId     Int
  inicio        DateTime
  fim           DateTime
  quantidade    Int         @default(1)
  createdAt     DateTime    @default(now())
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id])
  recurso       Recurso     @relation(fields: [recursoId], references: [id])

  @@unique([agendamentoId, recursoId])
  @@index([recursoId, inicio, fim])
  @@map("agendamentos_recursos")
}

model HistoricoReagendamento {
  id                Int         @id @default(autoincrement())
  agendamentoId     Int
  alteradoPorId     Int
  dataAnterior      DateTime
  dataFimAnterior   DateTime?
  unidadeIdAnterior Int?
  dataNova          DateTime
  dataFimNova       DateTime
  unidadeIdNova     Int?
  motivo            String?     @db.Text
  createdAt         DateTime    @default(now())
  agendamento       Agendamento @relation(fields: [agendamentoId], references: [id])
  alteradoPor       Usuario     @relation("HistoricoReagendamentoAutor", fields: [alteradoPorId], references: [id])

  @@index([agendamentoId, createdAt])
  @@index([alteradoPorId])
  @@map("historico_reagendamentos")
}

model Requisito {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  nome      String
  descricao String?   @db.Text
  tipo      String    @default("INFORMATIVO")
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  servicos  ServicoRequisito[]

  @@map("requisitos")
}

model ServicoRequisito {
  id          Int       @id @default(autoincrement())
  servicoId   Int
  requisitoId Int
  obrigatorio Boolean   @default(true)
  observacao  String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  servico     Servico   @relation(fields: [servicoId], references: [id])
  requisito   Requisito @relation(fields: [requisitoId], references: [id])

  @@unique([servicoId, requisitoId])
  @@index([requisitoId])
  @@map("servicos_requisitos")
}

model ClienteEstabelecimento {
  id          Int       @id @default(autoincrement())
  estabelecimentoId Int
  usuarioId   Int
  origem      String    @default("AGENDAMENTO")
  primeiroAgendamentoEm DateTime?
  ultimoAgendamentoEm   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@unique([estabelecimentoId, usuarioId])
  @@index([usuarioId])
  @@map("clientes_estabelecimentos")
}

model Unidade {
  id          Int       @id @default(autoincrement())
  estabelecimentoId Int
  nome        String
  endereco    String?
  telefone    String?
  ativa       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  horariosFuncionamento HorarioFuncionamento[]
  bloqueiosAgenda       BloqueioAgenda[]
  recursos              Recurso[]
  agendamentos          Agendamento[]
  escalasProfissionais  EscalaProfissional[]

  @@unique([estabelecimentoId, nome])
  @@index([estabelecimentoId])
  @@map("unidades")
}

model HorarioFuncionamento {
  id              Int       @id @default(autoincrement())
  estabelecimentoId     Int
  unidadeId       Int?
  diaSemana       Int
  inicio          String    @db.VarChar(5)
  fim             String    @db.VarChar(5)
  intervaloInicio String?   @db.VarChar(5)
  intervaloFim    String?   @db.VarChar(5)
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  estabelecimento       Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  unidade         Unidade?  @relation(fields: [unidadeId], references: [id])

  @@index([estabelecimentoId, diaSemana])
  @@index([unidadeId])
  @@map("horarios_funcionamento")
}

model BloqueioAgenda {
  id             Int           @id @default(autoincrement())
  estabelecimentoId    Int
  profissionalId Int?
  unidadeId      Int?
  inicio         DateTime
  fim            DateTime
  motivo         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  estabelecimento      Estabelecimento     @relation(fields: [estabelecimentoId], references: [id])
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  unidade        Unidade?      @relation(fields: [unidadeId], references: [id])

  @@index([estabelecimentoId, inicio, fim])
  @@index([profissionalId, inicio, fim])
  @@index([unidadeId, inicio, fim])
  @@map("bloqueios_agenda")
}

model LancamentoFinanceiro {
  id             Int           @id @default(autoincrement())
  estabelecimentoId    Int
  profissionalId Int?
  usuarioId      Int?
  tipo           String
  categoria      String?
  descricao      String
  valor          Decimal       @db.Decimal(10, 2)
  data           DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  estabelecimento      Estabelecimento     @relation(fields: [estabelecimentoId], references: [id])
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  usuario        Usuario?      @relation(fields: [usuarioId], references: [id])

  @@index([estabelecimentoId, data])
  @@index([profissionalId, data])
  @@index([usuarioId])
  @@map("lancamentos_financeiros")
}

model ConfiguracaoComissao {
  id                Int             @id @default(autoincrement())
  estabelecimentoId Int
  profissionalId    Int?
  servicoId         Int?
  chave             String
  percentual        Decimal         @db.Decimal(5, 2)
  ativo             Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  profissional      Profissional?   @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  servico           Servico?        @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@unique([estabelecimentoId, chave])
  @@index([estabelecimentoId, ativo])
  @@index([profissionalId])
  @@index([servicoId])
  @@map("configuracoes_comissao")
}

model FormaPagamento {
  id                Int             @id @default(autoincrement())
  estabelecimentoId Int
  nome              String
  tipo              String
  taxaPercentual    Decimal         @default(0) @db.Decimal(5, 2)
  taxaFixa          Decimal         @default(0) @db.Decimal(10, 2)
  prazoRecebimento  Int             @default(0)
  ativa             Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  contas            ContaFinanceira[]

  @@unique([estabelecimentoId, nome])
  @@index([estabelecimentoId, ativa])
  @@map("formas_pagamento")
}

model ContaFinanceira {
  id                Int              @id @default(autoincrement())
  estabelecimentoId Int
  agendamentoId     Int?             @unique
  formaPagamentoId  Int?
  tipo              String
  categoria         String?
  descricao         String
  documento         String?
  valorOriginal     Decimal          @db.Decimal(10, 2)
  valorPago         Decimal          @default(0) @db.Decimal(10, 2)
  status            String           @default("PENDENTE")
  competencia       DateTime
  vencimento        DateTime
  pagoEm            DateTime?
  observacoes       String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  estabelecimento   Estabelecimento  @relation(fields: [estabelecimentoId], references: [id])
  agendamento       Agendamento?     @relation(fields: [agendamentoId], references: [id])
  formaPagamento    FormaPagamento?  @relation(fields: [formaPagamentoId], references: [id])
  conciliacoes      ConciliacaoFinanceira[]

  @@index([estabelecimentoId, tipo, status, vencimento])
  @@index([formaPagamentoId])
  @@map("contas_financeiras")
}

model FechamentoCaixa {
  id                Int             @id @default(autoincrement())
  estabelecimentoId Int
  abertoPorId       Int
  fechadoPorId      Int?
  status            String          @default("ABERTO")
  chaveAberto       String?         @unique
  abertoEm          DateTime        @default(now())
  fechadoEm         DateTime?
  saldoInicial      Decimal         @default(0) @db.Decimal(10, 2)
  totalReceitas     Decimal         @default(0) @db.Decimal(10, 2)
  totalDespesas     Decimal         @default(0) @db.Decimal(10, 2)
  saldoEsperado     Decimal         @default(0) @db.Decimal(10, 2)
  saldoInformado    Decimal?        @db.Decimal(10, 2)
  diferenca         Decimal?        @db.Decimal(10, 2)
  observacoes       String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  abertoPor         Usuario         @relation("CaixaAbertoPor", fields: [abertoPorId], references: [id])
  fechadoPor        Usuario?        @relation("CaixaFechadoPor", fields: [fechadoPorId], references: [id])

  @@index([estabelecimentoId, status, abertoEm])
  @@index([abertoPorId])
  @@index([fechadoPorId])
  @@map("fechamentos_caixa")
}

model RepasseFinanceiro {
  id                Int             @id @default(autoincrement())
  estabelecimentoId Int
  profissionalId    Int
  periodoInicio     DateTime
  periodoFim        DateTime
  receitaBruta      Decimal         @db.Decimal(10, 2)
  percentualMedio   Decimal         @db.Decimal(5, 2)
  valorComissao     Decimal         @db.Decimal(10, 2)
  ajustes           Decimal         @default(0) @db.Decimal(10, 2)
  valorLiquido      Decimal         @db.Decimal(10, 2)
  status            String          @default("PENDENTE")
  pagoEm            DateTime?
  observacoes       String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  estabelecimento   Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  profissional      Profissional    @relation(fields: [profissionalId], references: [id])

  @@unique([estabelecimentoId, profissionalId, periodoInicio, periodoFim])
  @@index([estabelecimentoId, status, periodoFim])
  @@index([profissionalId])
  @@map("repasses_financeiros")
}

model PlanoAssinatura {
  id              Int                  @id @default(autoincrement())
  nome            String               @unique
  slug            String               @unique
  descricao       String               @db.Text
  precoMensal     Decimal              @db.Decimal(10, 2)
  limiteUsuarios  Int
  limiteUnidades  Int
  limiteServicos  Int
  recursos        Json
  ativo           Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assinaturas     AssinaturaEstabelecimento[]

  @@map("planos_assinatura")
}

model AssinaturaEstabelecimento {
  id              Int              @id @default(autoincrement())
  estabelecimentoId     Int              @unique
  planoId         Int
  status          String           @default("TRIAL")
  trialEndsAt     DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean        @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  estabelecimento       Estabelecimento        @relation(fields: [estabelecimentoId], references: [id])
  plano           PlanoAssinatura  @relation(fields: [planoId], references: [id])
  cobrancas       CobrancaAssinatura[]

  @@index([planoId])
  @@index([status])
  @@map("assinaturas_estabelecimentos")
}

model CobrancaAssinatura {
  id             Int                       @id @default(autoincrement())
  assinaturaId   Int
  provedor       String                    @default("MANUAL")
  referenciaExterna String?                @unique
  valor          Decimal                   @db.Decimal(10, 2)
  status         String                    @default("PENDENTE")
  vencimento     DateTime
  pagoEm         DateTime?
  tentativas     Int                       @default(0)
  linkPagamento  String?                   @db.Text
  codigoPix      String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  assinatura     AssinaturaEstabelecimento @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@index([assinaturaId, status, vencimento])
  @@map("cobrancas_assinaturas")
}

model EventoGatewayPagamento {
  id                Int             @id @default(autoincrement())
  estabelecimentoId Int?
  provedor          String
  eventoExternoId   String
  tipo              String
  payload           Json
  status            String          @default("PENDENTE")
  processadoEm      DateTime?
  erro              String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])

  @@unique([provedor, eventoExternoId])
  @@index([estabelecimentoId, createdAt])
  @@index([status, createdAt])
  @@map("eventos_gateway_pagamento")
}

model ConciliacaoFinanceira {
  id                 Int             @id @default(autoincrement())
  estabelecimentoId  Int
  contaFinanceiraId  Int?
  provedor           String
  transacaoExternaId String
  valorEsperado      Decimal         @db.Decimal(10, 2)
  valorRecebido      Decimal         @db.Decimal(10, 2)
  diferenca          Decimal         @db.Decimal(10, 2)
  status             String          @default("PENDENTE")
  conciliadoEm       DateTime?
  observacoes        String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  estabelecimento    Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  contaFinanceira    ContaFinanceira? @relation(fields: [contaFinanceiraId], references: [id])

  @@unique([estabelecimentoId, provedor, transacaoExternaId])
  @@index([estabelecimentoId, status, createdAt])
  @@index([contaFinanceiraId])
  @@map("conciliacoes_financeiras")
}

model LogAuditoria {
  id          Int       @id @default(autoincrement())
  estabelecimentoId Int?
  usuarioId   Int?
  acao        String
  entidade    String
  entidadeId  String?
  detalhes    Json?
  createdAt   DateTime  @default(now())
  estabelecimento   Estabelecimento? @relation(fields: [estabelecimentoId], references: [id])
  usuario     Usuario?   @relation(fields: [usuarioId], references: [id])

  @@index([estabelecimentoId, createdAt])
  @@index([usuarioId, createdAt])
  @@map("logs_auditoria")
}

model LembreteRelacionamento {
  id             Int          @id @default(autoincrement())
  estabelecimentoId    Int
  usuarioId      Int?
  agendamentoId  Int?
  tipo           String
  canal          String       @default("WHATSAPP")
  status         String       @default("PENDENTE")
  mensagem       String       @db.Text
  dataPrevista   DateTime
  enviadoEm      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  estabelecimento      Estabelecimento    @relation(fields: [estabelecimentoId], references: [id])
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([estabelecimentoId, status, dataPrevista])
  @@index([usuarioId])
  @@map("lembretes_relacionamento")
}

model Avaliacao {
  id             Int          @id @default(autoincrement())
  estabelecimentoId    Int
  agendamentoId  Int          @unique
  usuarioId      Int
  profissionalId Int
  nota           Int
  comentario     String?      @db.Text
  status         String       @default("APPROVED")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  estabelecimento      Estabelecimento    @relation(fields: [estabelecimentoId], references: [id])
  agendamento    Agendamento  @relation(fields: [agendamentoId], references: [id])
  usuario        Usuario      @relation(fields: [usuarioId], references: [id])
  profissional   Profissional @relation(fields: [profissionalId], references: [id])

  @@index([estabelecimentoId, status])
  @@index([profissionalId, status])
  @@index([usuarioId])
  @@map("avaliacoes")
}

model DenunciaPerfilPublico {
  id            Int       @id @default(autoincrement())
  estabelecimentoId   Int
  nome          String?
  email         String?
  motivo        String
  mensagem      String    @db.Text
  status        String    @default("PENDENTE")
  resolucao     String?   @db.Text
  revisadoPorId Int?
  revisadoEm    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  estabelecimento     Estabelecimento @relation(fields: [estabelecimentoId], references: [id])
  revisadoPor   Usuario?  @relation("DenunciaPerfilRevisor", fields: [revisadoPorId], references: [id])

  @@index([estabelecimentoId, status, createdAt])
  @@index([revisadoPorId])
  @@map("denuncias_perfil_publico")
}
